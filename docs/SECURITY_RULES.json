{
  "rules": {
    "devices": {
      "$dev": {
        "current": {
          ".read": true,
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['temp', 'hum', 'ts'])"
        },
        "hourly": {
          ".read": true,
          "$hour": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['temp', 'hum', 'count'])"
          }
        },
        "health": {
          ".read": true,
          ".write": "auth != null"
        }
      }
    }
  }
}
